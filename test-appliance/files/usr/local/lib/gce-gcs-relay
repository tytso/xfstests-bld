# These must match gce-gcs-curl and gce-do-setup
PROTOCOL_VERSION = 1
RELAY_PREFIX = 'gcs-relay'
SUBSCRIPTION_SUFFIX = '-gcs-relay'

METADATA_URL = 'http://metadata.google.internal/computeMetadata/v1'
STORAGE_URL = 'https://storage.googleapis.com'
PUBSUB_URL = 'https://pubsub.googleapis.com'
SERVER_URL = 'https://127.0.0.1:443'

DEFAULT_TIMEOUT = 120
MAX_TIMEOUT = 3600
DEFAULT_MAX_WORKERS = 8
MAX_REQUEST_SIZE = 4 << 20      # of the JSON object, in bytes
MAX_RESPONSE_SIZE = 8 << 20     # of the response body, in bytes
DEFAULT_PULL_TIMEOUT = 60
DEFAULT_CONFIG_RETRY = 300
MAX_PULL_MESSAGES = 16

OBJECT_RE = re.compile(r'^(req|rsp)/([A-Za-z0-9][A-Za-z0-9._-]{0,127})\.json$')
GENERATION_RE = re.compile(r'^[0-9]{1,32}$')
METHOD_RE = re.compile(r'^[A-Z]{1,16}$')
HEADER_NAME_RE = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+$")
TIME_RE = re.compile(r'^(\d{4})-(\d\d)-(\d\d)[Tt](\d\d):(\d\d):(\d\d)'
                     r'(\.\d+)?([Zz]|[+-]\d\d:\d\d)$')

# Headers which describe a single connection, and so which must not be
# passed along.  (Content-Length is recalculated.)
HOP_BY_HOP = frozenset([
    'connection', 'content-length', 'expect', 'keep-alive',
    'proxy-authenticate', 'proxy-authorization', 'proxy-connection', 'te',
    'trailer', 'transfer-encoding', 'upgrade'])

NETWORK_ERRORS = (urllib.error.URLError, http.client.HTTPException, OSError)

debugging = False
log_lock = threading.Lock()


class Stop(Exception):
    """Raised by the signal handler to make the daemon exit"""


class RelayError(Exception):
    """Something went wrong talking to metadata, GCS, or Pub/Sub"""


class PubSubConfigError(RelayError):
    """A non-transient Pub/Sub provisioning, IAM, or OAuth scope error"""

    def __init__(self, kind, msg):
        super().__init__(msg)
        self.kind = kind


class ObjectTooLarge(Exception):
    """A GCS request object exceeded MAX_REQUEST_SIZE"""


class BadRequest(Exception):
    """A request which can't be passed to the server"""


def log(msg):
    with log_lock:
        sys.stderr.write(msg + '\n')
        sys.stderr.flush()


def debug(msg):
    if debugging:
        log(msg)


def parse_time(when):
    """Converts an RFC 3339 timestamp to seconds since the epoch"""
    m = TIME_RE.match(when or '')
    if not m:
        return None
    t = calendar.timegm(tuple(int(m.group(i)) for i in range(1, 7)))
    if m.group(7):
        t += float(m.group(7))
    zone = m.group(8)
    if zone not in ('Z', 'z'):
        offset = int(zone[1:3]) * 3600 + int(zone[4:6]) * 60
        t += -offset if zone[0] == '+' else offset
    return t


def parse_http_date(headers):
    """Returns the server clock from an HTTP Date header, or local time"""
    try:
        return email.utils.parsedate_to_datetime(
            headers.get('Date')).timestamp()
    except (TypeError, ValueError, AttributeError):
        return time.time()


class Metadata:
    """The GCE metadata server"""

    def __init__(self, url):
        self.url = url.rstrip('/')
        # The metadata server must never be accessed via a proxy
        self.opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}))
        self.token_lock = threading.Lock()
        self.access_token = None
        self.token_expires = 0

    def get(self, path, timeout=30):
        """Returns (contents, ETag); the contents are None if not found"""
        req = urllib.request.Request(self.url + '/' + path,
                                     headers={'Metadata-Flavor': 'Google'})
        try:
            with self.opener.open(req, timeout=timeout) as resp:
                return resp.read().decode('utf-8'), resp.headers.get('ETag')
        except urllib.error.HTTPError as e:
            if e.code in (304, 404):
                return None, None
            raise RelayError('metadata server: HTTP status %d for %s'
                             % (e.code, path))
        except NETWORK_ERRORS as e:
            raise RelayError('metadata server: %s' % e)

    def token(self):
        """Returns an access token for the VM's service account"""
        with self.token_lock:
            now = time.monotonic()
            if self.access_token is None or now >= self.token_expires:
                contents, _ = self.get(
                    'instance/service-accounts/default/token')
                try:
                    tok = json.loads(contents or '')
                    self.access_token = tok['access_token']
                    self.token_expires = (now + int(tok.get('expires_in', 0))
                                          - 120)
                except (ValueError, KeyError, TypeError):
                    raise RelayError('metadata server: could not get an '
                                     'access token for the service account')
            return self.access_token

    def forget_token(self, token):
        with self.token_lock:
            if self.access_token == token:
                self.access_token = None


class Storage:
    """A GCS bucket, accessed using the JSON API"""

    def __init__(self, url, bucket, metadata):
        self.url = url.rstrip('/')
        self.bucket = urllib.parse.quote(bucket, safe='')
        self.metadata = metadata
        self.opener = urllib.request.build_opener()

    def call(self, method, path, query, data=None, max_bytes=None):
        """Returns (HTTP status, headers, body)"""
        url = '%s%s?%s' % (self.url, path, urllib.parse.urlencode(query))
        delay = 1
        error = None
        for attempt in range(4):
            token = self.metadata.token()
            headers = {'Authorization': 'Bearer ' + token}
            if data is not None:
                headers['Content-Type'] = 'application/json'
            req = urllib.request.Request(url, data=data, headers=headers,
                                         method=method)
            try:
                with self.opener.open(req, timeout=60) as resp:
                    if max_bytes is not None:
                        try:
                            cl = int(resp.headers.get('Content-Length') or 0)
                        except ValueError:
                            cl = 0
                        if cl >= max_bytes:
                            return resp.status, resp.headers, None
                        body = resp.read(max_bytes)
                    else:
                        body = resp.read()
                    return resp.status, resp.headers, body
            except urllib.error.HTTPError as e:
                status, headers, body = e.code, e.headers, e.read()
                if status == 401 and attempt == 0:
                    self.metadata.forget_token(token)
                    continue
                if status not in (408, 429) and status < 500:
                    return status, headers, body
                error = 'HTTP status %d' % status
            except NETWORK_ERRORS as e:
                error = str(e)
            if attempt < 3:
                time.sleep(delay)
                delay *= 2
        raise RelayError('GCS: %s %s: %s' % (method, path, error))

    def object_path(self, name):
        return '/storage/v1/b/%s/o/%s' % (self.bucket,
                                          urllib.parse.quote(name, safe=''))

    def list(self, prefix):
        """Returns (the objects with the given prefix, now, listed_at)

        Each object is a dict with the members "name", "generation",
        "timeCreated", and "size".  "now" is the time according to GCS,
        so that it can be compared to the objects' creation times, and
        "listed_at" is the local monotonic time when it was recorded.
        """
        items = []
        now = None
        listed_at = None
        query = {'prefix': prefix,
                 'fields': 'items(name,generation,timeCreated,size),'
                           'nextPageToken'}
        while True:
            status, headers, body = self.call(
                'GET', '/storage/v1/b/%s/o' % self.bucket, query)
            if status != 200:
                raise RelayError('GCS: listing gs://%s/%s: HTTP status %d'
                                 % (self.bucket, prefix, status))
            if now is None:
                listed_at = time.monotonic()
                now = parse_http_date(headers)
            try:
                doc = json.loads(body.decode('utf-8'))
                items.extend(doc.get('items') or [])
                query['pageToken'] = doc.get('nextPageToken')
            except (ValueError, AttributeError):
                raise RelayError('GCS: malformed object listing')
            if not query['pageToken']:
                return items, now, listed_at

    def get(self, name, generation, max_size=None):
        """Returns (contents, now), or (None, None) if the object is gone

        Raises ObjectTooLarge if max_size is given and the object is
        larger than max_size bytes.
        """
        max_bytes = max_size + 1 if max_size is not None else None
        status, headers, body = self.call(
            'GET', self.object_path(name),
            {'alt': 'media', 'generation': generation},
            max_bytes=max_bytes)
        if status == 200:
            if max_size is not None and (body is None or len(body) > max_size):
                raise ObjectTooLarge()
            return body, parse_http_date(headers)
        if status == 404:
            return None, None
        raise RelayError('GCS: reading %s: HTTP status %d' % (name, status))

    def put(self, name, data):
        status, _, _ = self.call('POST', '/upload/storage/v1/b/%s/o'
                                 % self.bucket,
                                 {'uploadType': 'media', 'name': name}, data)
        if status != 200:
            raise RelayError('GCS: writing %s: HTTP status %d'
                             % (name, status))

    def delete(self, name, generation):
        """Deletes an object; returns False if someone else already did"""
        status, _, _ = self.call('DELETE', self.object_path(name),
                                 {'ifGenerationMatch': generation})
        if status in (200, 204):
            return True
        if status in (404, 412):
            return False
        raise RelayError('GCS: deleting %s: HTTP status %d' % (name, status))


class PubSub:
    """A Cloud Pub/Sub pull subscription, accessed using the REST API"""

    def __init__(self, url, project, subscription, metadata):
        self.url = url.rstrip('/')
        self.metadata = metadata
        self.opener = urllib.request.build_opener()
        if subscription.startswith('projects/'):
            parts = subscription.split('/')
            if (len(parts) != 4 or parts[0] != 'projects' or
                    parts[2] != 'subscriptions' or not parts[1] or
                    not parts[3]):
                raise SystemExit('bad subscription name: ' + subscription)
            sub_project, sub_id = parts[1], parts[3]
        else:
            sub_project, sub_id = project, subscription
        self.sub_project = sub_project
        self.subscription = 'projects/%s/subscriptions/%s' % (
            sub_project, sub_id)
        self.path_prefix = '/v1/projects/%s/subscriptions/%s' % (
            urllib.parse.quote(sub_project, safe=':'),
            urllib.parse.quote(sub_id, safe=''))

    def _config_error(self, status, body):
        reasons = set()
        message = ''
        try:
            err = json.loads(body.decode('utf-8')).get('error') or {}
            if isinstance(err, dict):
                message = str(err.get('message') or '')
                for detail in err.get('details') or []:
                    if isinstance(detail, dict) and detail.get('reason'):
                        reasons.add(str(detail['reason']))
        except (ValueError, UnicodeDecodeError, AttributeError):
            pass
        low = message.lower()
        if status == 404:
            return PubSubConfigError(
                'not_found',
                'Pub/Sub subscription %s does not exist (run '
                '"gce-xfstests setup" to create it)' % self.subscription)
        if ('ACCESS_TOKEN_SCOPE_INSUFFICIENT' in reasons or
                'insufficient authentication scopes' in low):
            return PubSubConfigError(
                'scope',
                'VM lacks the Pub/Sub OAuth scope '
                '(https://www.googleapis.com/auth/pubsub); relaunch this VM '
                'using an updated gce-xfstests')
        if ('SERVICE_DISABLED' in reasons or
                'has not been used in project' in low or
                'api is disabled' in low or 'it is disabled' in low):
            return PubSubConfigError(
                'api_disabled',
                'Cloud Pub/Sub API is disabled in project %s (run '
                '"gce-xfstests setup" to enable it)' % self.sub_project)
        return PubSubConfigError(
            'permission',
            'permission denied accessing Pub/Sub subscription %s (run '
            '"gce-xfstests setup" to grant roles/pubsub.subscriber)'
            % self.subscription)

    def pull(self, max_messages, timeout):
        """Long-polls for messages; returns a list of ReceivedMessage dicts"""
        url = self.url + self.path_prefix + ':pull'
        data = json.dumps({'maxMessages': max_messages}).encode('utf-8')
        start = time.monotonic()
        for attempt in range(2):
            token = self.metadata.token()
            headers = {
                'Authorization': 'Bearer ' + token,
                'Content-Type': 'application/json',
            }
            req = urllib.request.Request(url, data=data, headers=headers,
                                         method='POST')
            try:
                with self.opener.open(req, timeout=timeout) as resp:
                    body = resp.read()
            except urllib.error.HTTPError as e:
                status, body = e.code, e.read()
                if status == 401 and attempt == 0:
                    self.metadata.forget_token(token)
                    continue
                if status in (403, 404):
                    raise self._config_error(status, body)
                raise RelayError('Pub/Sub: pull %s: HTTP status %d'
                                 % (self.subscription, status))
            except socket.timeout:
                return []
            except urllib.error.URLError as e:
                if (isinstance(e.reason, socket.timeout) and
                        time.monotonic() - start >= timeout * 0.8):
                    return []
                raise RelayError('Pub/Sub: pull %s: %s'
                                 % (self.subscription, e))
            except (http.client.HTTPException, OSError) as e:
                raise RelayError('Pub/Sub: pull %s: %s'
                                 % (self.subscription, e))
            try:
                doc = json.loads(body.decode('utf-8')) if body.strip() else {}
                if not isinstance(doc, dict):
                    raise ValueError
                msgs = doc.get('receivedMessages') or []
                if not isinstance(msgs, list):
                    raise ValueError
                return msgs
            except (ValueError, UnicodeDecodeError):
                raise RelayError('Pub/Sub: malformed pull response')
        raise RelayError('Pub/Sub: pull %s: HTTP status 401'
                         % self.subscription)

    def acknowledge(self, ack_ids):
        """Acknowledges received messages"""
        if not ack_ids:
            return
        url = self.url + self.path_prefix + ':acknowledge'
        data = json.dumps({'ackIds': list(ack_ids)}).encode('utf-8')
        delay = 1
        error = None
        for attempt in range(4):
            token = self.metadata.token()
            headers = {
                'Authorization': 'Bearer ' + token,
                'Content-Type': 'application/json',
            }
            req = urllib.request.Request(url, data=data, headers=headers,
                                         method='POST')
            try:
                with self.opener.open(req, timeout=30) as resp:
                    resp.read()
                    return
            except urllib.error.HTTPError as e:
                status, body = e.code, e.read()
                if status == 401 and attempt == 0:
                    self.metadata.forget_token(token)
                    continue
                if status in (403, 404):
                    raise self._config_error(status, body)
                if status not in (408, 429) and status < 500:
                    raise RelayError('Pub/Sub: acknowledge %s: HTTP status %d'
                                     % (self.subscription, status))
                error = 'HTTP status %d' % status
            except NETWORK_ERRORS as e:
                error = str(e)
            if attempt < 3:
                time.sleep(delay)
                delay *= 2
        raise RelayError('Pub/Sub: acknowledge %s: %s'
                         % (self.subscription, error))


class Request:
    """A request from a client, which has been checked for sanity"""

    def __init__(self, data):
        try:
            req = json.loads(data.decode('utf-8'))
        except ValueError:
            raise BadRequest('the request is not valid JSON')
        if not isinstance(req, dict):
            raise BadRequest('the request is not a JSON object')
        if req.get('version') != PROTOCOL_VERSION:
            raise BadRequest('unsupported protocol version: %r'
                             % (req.get('version'),))

        self.method = req.get('method')
        if (not isinstance(self.method, str) or
                not METHOD_RE.match(self.method)):
            raise BadRequest('bad request method')

        self.path = req.get('path')
        if (not isinstance(self.path, str) or
                not self.path.startswith('/') or len(self.path) > 8192 or
                any(ord(ch) <= 0x20 or ord(ch) == 0x7f for ch in self.path)):
            raise BadRequest('bad request path')

        self.headers = []
        headers = req.get('headers') or []
        if not isinstance(headers, list) or len(headers) > 100:
            raise BadRequest('bad request headers')
        for header in headers:
            if (not isinstance(header, list) or len(header) != 2 or
                    not isinstance(header[0], str) or
                    not isinstance(header[1], str) or
                    not HEADER_NAME_RE.match(header[0]) or
                    any(ch in header[1] for ch in '\r\n\0')):
                raise BadRequest('bad request header')
            self.headers.append((header[0], header[1]))

        self.body = None
        if req.get('body') is not None:
            try:
                self.body = base64.b64decode(req['body'], validate=True)
            except (TypeError, ValueError):
                raise BadRequest('bad request body')

        timeout = req.get('timeout', DEFAULT_TIMEOUT)
        if (isinstance(timeout, bool) or
                not isinstance(timeout, (int, float)) or
                not 0 < timeout < float('inf')):
            raise BadRequest('bad request timeout')
        self.timeout = min(timeout, MAX_TIMEOUT)


def error_response(kind, msg):
    return {'version': PROTOCOL_VERSION, 'kind': kind, 'error': msg}


class Relay:
    def __init__(self, args):
        self.args = args
        self.metadata = Metadata(args.metadata_url)
        self.storage = None
        self.pubsub = None
        self.bucket = None
        self.instance = None
        self.project = None
        self.executor = None
        self.lock = threading.Lock()
        self.in_flight = set()          # (name, generation) queued or running
        self.next_cleanup = None        # monotonic time for next rsp cleanup
        self.saturated = False          # in-flight queue limit was reached
        self.max_in_flight = max(64, args.max_workers * 4)
        self.stopping = False
        self.interruptible = False

        server = urllib.parse.urlsplit(args.server_url)
        if server.scheme not in ('http', 'https') or not server.hostname:
            raise SystemExit('bad server URL: ' + args.server_url)
        self.server_tls = server.scheme == 'https'
        self.server_host = server.hostname
        self.server_port = server.port or (443 if self.server_tls else 80)
        self.server_netloc = server.netloc
        self.ssl_context = None
        if self.server_tls:
            # The server uses a self-signed certificate.  It is not
            # checked, since this is a connection to the local host.
            self.ssl_context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            self.ssl_context.check_hostname = False
            self.ssl_context.verify_mode = ssl.CERT_NONE

    def on_signal(self, signum, frame):
        """Stop taking new requests; finish any that were already claimed"""
        self.stopping = True
        if self.interruptible:
            raise Stop()

    def sleep(self, seconds):
        if self.stopping or seconds <= 0:
            return
        self.interruptible = True
        try:
            if not self.stopping:
                time.sleep(seconds)
        finally:
            self.interruptible = False

    def schedule_cleanup(self, delay):
        due = time.monotonic() + max(0.0, delay)
        with self.lock:
            if self.next_cleanup is None or due < self.next_cleanup:
                self.next_cleanup = due

    def cleanup_due(self):
        with self.lock:
            return (self.next_cleanup is not None and
                    time.monotonic() >= self.next_cleanup)

    def pull_wait(self, need_scan):
        wait = self.args.pull_timeout
        if need_scan:
            wait = min(wait, 1.0)
        with self.lock:
            next_cleanup = self.next_cleanup
            busy = bool(self.in_flight)
        if next_cleanup is not None:
            wait = min(wait, max(0.5, next_cleanup - time.monotonic()))
        if busy:
            wait = min(wait, max(1.0, self.args.response_ttl))
        return max(0.5, wait)

    def setup(self):
        """Finds out the instance name, GCE project, and bucket to use"""
        delay = 5
        while not self.stopping:
            try:
                self.instance = self.args.instance
                if not self.instance:
                    self.instance = (self.metadata.get('instance/name')[0]
                                     or '').strip()
                self.project = self.args.project
                if not self.project:
                    self.project = (self.metadata.get('project/project-id')[0]
                                    or '').strip()
                bucket = self.args.bucket
                for where in ('instance', 'project'):
                    if not bucket:
                        bucket = (self.metadata.get(
                            where + '/attributes/gs_bucket')[0] or '').strip()
                if self.instance and self.project and bucket:
                    break
                if not self.instance:
                    missing = 'instance name'
                elif not self.project:
                    missing = 'GCE project ID'
                else:
                    missing = ('GCS bucket (the gs_bucket metadata attribute '
                               'is not set)')
                log('cannot determine the %s; will retry in %d seconds'
                    % (missing, delay))
            except RelayError as e:
                log('%s; will retry in %d seconds' % (e, delay))
            self.sleep(delay)
            delay = min(delay * 2, 300)
        if self.stopping:
            raise Stop()
        self.bucket = bucket
        self.storage = Storage(self.args.storage_url, bucket, self.metadata)
        sub = self.args.subscription or ('%s%s' % (self.instance,
                                                   SUBSCRIPTION_SUFFIX))
        self.pubsub = PubSub(self.args.pubsub_url, self.project, sub,
                             self.metadata)
        self.prefix = '%s/%s-%s/' % (RELAY_PREFIX, self.instance, self.project)
        log('relaying requests from gs://%s/%s (subscription %s) to %s'
            % (bucket, self.prefix, self.pubsub.subscription,
               self.args.server_url))

    def forward(self, req, timeout):
        """Passes a request to the server, and returns the response"""
        if self.server_tls:
            conn = http.client.HTTPSConnection(
                self.server_host, self.server_port, timeout=timeout,
                context=self.ssl_context)
        else:
            conn = http.client.HTTPConnection(
                self.server_host, self.server_port, timeout=timeout)
        try:
            try:
                conn.connect()
            except OSError as e:
                return error_response(
                    'connect', 'cannot connect to the server at %s: %s'
                    % (self.args.server_url, e))
            conn.putrequest(req.method, req.path, skip_host=True,
                            skip_accept_encoding=True)
            have_host = False
            for name, value in req.headers:
                if name.lower() in HOP_BY_HOP:
                    continue
                if name.lower() == 'host':
                    have_host = True
                conn.putheader(name, value)
            if not have_host:
                conn.putheader('Host', self.server_netloc)
            if req.body is not None or req.method in ('POST', 'PUT', 'PATCH'):
                conn.putheader('Content-Length', str(len(req.body or b'')))
            conn.putheader('Connection', 'close')
            conn.endheaders(req.body or None)
            resp = conn.getresponse()
            body = resp.read(MAX_RESPONSE_SIZE + 1)
            if len(body) > MAX_RESPONSE_SIZE:
                return error_response('transport',
                                      "the server's response is too large")
            return {
                'version': PROTOCOL_VERSION,
                'status': resp.status,
                'reason': resp.reason,
                'headers': [[name, value] for name, value in resp.getheaders()
                            if name.lower() not in HOP_BY_HOP],
                'body': base64.b64encode(body).decode('ascii'),
            }
        except socket.timeout:
            return error_response(
                'timeout', 'the server did not respond within %d seconds'
                % timeout)
        except (http.client.HTTPException, OSError, ValueError) as e:
            return error_response('transport',
                                  'request to the server failed: %s'
                                  % (e or type(e).__name__))
        finally:
            conn.close()

    def respond(self, request_id, response):
        try:
            self.storage.put('%srsp/%s.json' % (self.prefix, request_id),
                             json.dumps(response).encode('utf-8'))
            self.schedule_cleanup(self.args.response_ttl)
        except RelayError as e:
            log('%s: could not upload the response: %s' % (request_id, e))

    def handle(self, name, generation, request_id, created, size=None):
        """Claims a request and forwards it to the server (runs in a worker)"""
        if self.stopping:
            return
        try:
            if size is not None and size > MAX_REQUEST_SIZE:
                raise BadRequest('the request is too large')
            try:
                data, now = self.storage.get(name, generation,
                                             max_size=MAX_REQUEST_SIZE)
            except ObjectTooLarge:
                raise BadRequest('the request is too large')
            got_at = time.monotonic()
            if data is None:
                return
            req = Request(data)
        except BadRequest as e:
            if not self.stopping and self.storage.delete(name, generation):
                log('%s: rejected: %s' % (request_id, e))
                self.respond(request_id, error_response('request', str(e)))
            return

        age_at_get = max(0.0, now - created) if created is not None else 0.0
        if age_at_get > req.timeout:
            if not self.stopping and self.storage.delete(name, generation):
                log('%s: ignored, since it is %d seconds old'
                    % (request_id, age_at_get))
            return

        if self.stopping:
            return

        # Bodies and headers are never logged, since they can contain
        # the password or the session cookie.
        what = '%s: %s %s' % (request_id, req.method, req.path.split('?')[0])
        # Whoever deletes the request owns it, and the request is gone
        # before anything is done with it.  So even if things go wrong,
        # a duplicate notification arrives, or another scan runs
        # concurrently, the request is acted upon at most once.  Once
        # deleted, finish handling it even if a shutdown signal arrives.
        if not self.storage.delete(name, generation):
            return
        age = age_at_get + max(0.0, time.monotonic() - got_at)
        start = time.monotonic()
        response = self.forward(req, max(5, req.timeout - age))
        log('%s: %s (%.1f seconds)'
            % (what, response.get('error') or
               'HTTP status %s' % response.get('status'),
               time.monotonic() - start))
        self.respond(request_id, response)

    def expire_response(self, name, generation, request_id):
        if self.stopping:
            return
        try:
            if self.storage.delete(name, generation):
                debug('%s: removed the unclaimed response' % request_id)
        except RelayError:
            self.schedule_cleanup(min(30.0, self.args.response_ttl))
            raise

    def run_task(self, key, request_id, fn, *args):
        try:
            fn(*args)
        except RelayError as e:
            log('%s: %s' % (request_id, e))
        except Exception:
            log('%s: unexpected error:\n%s'
                % (request_id, traceback.format_exc()))
        finally:
            with self.lock:
                self.in_flight.discard(key)

    def submit(self, key, request_id, fn, *args):
        """Queues work for an object; returns None if the queue is full"""
        with self.lock:
            if self.stopping or key in self.in_flight:
                return False
            if len(self.in_flight) >= self.max_in_flight:
                return None
            self.in_flight.add(key)
        try:
            self.executor.submit(self.run_task, key, request_id, fn, *args)
        except RuntimeError:
            with self.lock:
                self.in_flight.discard(key)
            return False
        return True

    def dispatch(self, attrs):
        """Handles one Pub/Sub notification as an untrusted hint"""
        if not isinstance(attrs, dict):
            debug('ignoring notification with non-dict attributes')
            return
        if (attrs.get('eventType') != 'OBJECT_FINALIZE' or
                attrs.get('bucketId') != self.bucket):
            debug('ignoring notification: %r' % (attrs,))
            return
        name = attrs.get('objectId')
        generation = attrs.get('objectGeneration')
        if (not isinstance(name, str) or not name.startswith(self.prefix) or
                not isinstance(generation, str) or
                not GENERATION_RE.match(generation)):
            debug('ignoring notification: %r' % (attrs,))
            return
        m = OBJECT_RE.match(name[len(self.prefix):])
        if not m or m.group(1) != 'req':
            debug('ignoring notification: %r' % (attrs,))
            return
        request_id = m.group(2)
        created = parse_time(attrs.get('eventTime'))
        debug('received notification for %s (gen %s)'
              % (request_id, generation))
        if self.submit((name, generation), request_id, self.handle,
                       name, generation, request_id, created, None) is None:
            self.saturated = True

    def scan(self):
        """Dispatches pending requests in the bucket to the worker pool

        This also queues the removal of responses which were never
        picked up.  Returns True if the in-flight limit was reached
        before every object could be queued.
        """
        with self.lock:
            prev_cleanup = self.next_cleanup
            self.next_cleanup = None
        try:
            items, now, _ = self.storage.list(self.prefix)
        except Exception:
            if prev_cleanup is not None:
                self.schedule_cleanup(max(0.0, prev_cleanup - time.monotonic()))
            raise

        requests = []
        stale_responses = []
        min_remaining = None
        for item in sorted(items, key=lambda item: str(item.get('name'))):
            name = str(item.get('name'))
            generation = item.get('generation')
            m = OBJECT_RE.match(name[len(self.prefix):])
            if not m or generation is None:
                continue
            created = parse_time(item.get('timeCreated'))
            age = max(0.0, now - created) if created is not None else 0.0
            if m.group(1) == 'rsp':
                if age > self.args.response_ttl:
                    stale_responses.append((name, generation, m.group(2)))
                else:
                    rem = max(1.0, self.args.response_ttl - age)
                    if min_remaining is None or rem < min_remaining:
                        min_remaining = rem
                continue
            try:
                size = int(item.get('size'))
            except (TypeError, ValueError):
                size = None
            requests.append((name, generation, m.group(2), created, size))

        if min_remaining is not None:
            self.schedule_cleanup(min_remaining)

        # Queue requests ahead of cleaning up unclaimed responses so
        # cleanup can never starve live requests.
        for name, generation, request_id, created, size in requests:
            if self.stopping:
                return False
            if self.submit((name, generation), request_id, self.handle,
                           name, generation, request_id, created,
                           size) is None:
                return True
        for name, generation, request_id in stale_responses:
            if self.stopping:
                return False
            if self.submit((name, generation), request_id,
                           self.expire_response, name, generation,
                           request_id) is None:
                return True
        return False

    def run(self):
        args = self.args
        self.setup()
        with concurrent.futures.ThreadPoolExecutor(
                max_workers=args.max_workers) as executor:
            self.executor = executor
            if args.once:
                while not self.stopping and self.scan():
                    self.sleep(0.2)
                return
            self.serve()

    def serve(self):
        args = self.args
        need_scan = True        # startup scan, and recovery after errors
        config_error = None     # kind of currently logged PubSubConfigError
        delay = 0
        while not self.stopping:
            try:
                if self.saturated:
                    self.sleep(args.rescan_interval)
                    if self.stopping:
                        break
                    self.saturated = self.scan()
                    delay = 0
                    continue
                if not need_scan and self.cleanup_due():
                    self.saturated = self.scan()
                    delay = 0
                    continue

                wait = self.pull_wait(need_scan)
                start = time.monotonic()
                self.interruptible = True
                try:
                    if self.stopping:
                        break
                    msgs = self.pubsub.pull(MAX_PULL_MESSAGES, wait)
                finally:
                    self.interruptible = False

                if config_error is not None:
                    log('Pub/Sub pull succeeded; resuming normal operation')
                    config_error = None
                delay = 0

                if msgs:
                    ack_ids = [m['ackId'] for m in msgs
                               if isinstance(m, dict) and m.get('ackId')]
                    if ack_ids:
                        try:
                            self.pubsub.acknowledge(ack_ids)
                        except PubSubConfigError:
                            raise
                        except RelayError as e:
                            log('Pub/Sub acknowledge failed (continuing '
                                'with received notifications): %s' % e)
                    for m in msgs:
                        if self.stopping:
                            break
                        if isinstance(m, dict):
                            msg = m.get('message')
                            if isinstance(msg, dict):
                                self.dispatch(msg.get('attributes'))

                if need_scan and not self.stopping:
                    self.saturated = self.scan()
                    need_scan = False
                elif (not msgs and not self.stopping and
                      time.monotonic() - start < min(wait, 1.0)):
                    # Guard against a misbehaving endpoint returning empty
                    # responses immediately in a tight loop.
                    self.sleep(1.0)
            except PubSubConfigError as e:
                if e.kind != config_error:
                    log(str(e))
                    config_error = e.kind
                need_scan = True
                delay = 0
                self.sleep(args.config_retry_secs)
            except RelayError as e:
                delay = min(max(2 * delay, 1), 60)
                log('%s; will retry in %d seconds' % (e, delay))
                need_scan = True
                self.sleep(delay)
            except Stop:
                break
            except Exception:
                delay = min(max(2 * delay, 1), 60)
                log('unexpected error; will retry in %d seconds:\n%s'
                    % (delay, traceback.format_exc()))
                need_scan = True
                self.sleep(delay)


def positive_int(value):
    try:
        n = int(value)
        if n >= 1:
            return n
    except ValueError:
        pass
    raise argparse.ArgumentTypeError('must be a positive integer')


def positive_float(value):
    try:
        n = float(value)
        if 0 < n < float('inf'):
            return n
    except ValueError:
        pass
    raise argparse.ArgumentTypeError('must be a positive number')


def main():
    global debugging

    parser = argparse.ArgumentParser(
        description='Relay requests from the gce-xfstests GCS bucket to '
        'the LTM or KCS server running on this VM.')
    parser.add_argument('--debug', action='store_true',
                        help='log more about what is going on')
    parser.add_argument('--once', action='store_true',
                        help='handle the requests which are currently in '
                        'the bucket, and exit')
    parser.add_argument('--max-workers', type=positive_int,
                        default=DEFAULT_MAX_WORKERS, metavar='N',
                        help='maximum number of requests to handle in '
                        'parallel (default: %(default)d)')
    parser.add_argument('--server-url', default=SERVER_URL, metavar='URL',
                        help='where to send the requests '
                        '(default: %(default)s)')
    parser.add_argument('--bucket',
                        help='the GCS bucket (default: the gs_bucket '
                        'metadata attribute)')
    parser.add_argument('--instance',
                        help='the instance name (default: from the '
                        'metadata server)')
    parser.add_argument('--project',
                        help='the GCE project ID (default: from the '
                        'metadata server)')
    parser.add_argument('--subscription',
                        help='the Pub/Sub pull subscription '
                        '(default: <instance>-gcs-relay in this project)')
    parser.add_argument('--metadata-url', default=METADATA_URL,
                        metavar='URL', help=argparse.SUPPRESS)
    parser.add_argument('--storage-url', default=STORAGE_URL, metavar='URL',
                        help=argparse.SUPPRESS)
    parser.add_argument('--pubsub-url', default=PUBSUB_URL, metavar='URL',
                        help=argparse.SUPPRESS)
    parser.add_argument('--pull-timeout', type=positive_float,
                        default=DEFAULT_PULL_TIMEOUT, metavar='SECS',
                        help=argparse.SUPPRESS)
    parser.add_argument('--config-retry-secs', type=positive_float,
                        default=DEFAULT_CONFIG_RETRY, metavar='SECS',
                        help=argparse.SUPPRESS)
    parser.add_argument('--rescan-interval', type=positive_float, default=1,
                        metavar='SECS',
                        help='how often to re-list the bucket while '
                        'saturated (default: %(default)g)')
    parser.add_argument('--response-ttl', type=positive_float, default=300,
                        metavar='SECS',
                        help='how long to keep responses which have not '
                        'been picked up (default: %(default)g)')
    args = parser.parse_args()
    debugging = args.debug

    relay = Relay(args)
    signal.signal(signal.SIGTERM, relay.on_signal)
    signal.signal(signal.SIGINT, relay.on_signal)
    try:
        relay.run()
    except Stop:
        pass
    log('exiting')
    return 0


if __name__ == '__main__':
    sys.exit(main())
