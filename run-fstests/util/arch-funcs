#
# There are multiple ways that CPU architectured can be named.
# KERN_ARCH is what is used when specifying ARCH=xxx when building the
# kernel.
#
# GCE_ARCH is what gets used when setting specifying the architecture
# when creating the GCE image using the --architecture flag
# ARCH (after being canonicalized by this function) is defined by
# the Debian architecture port names[1] and is used internally
# by gce-xfstests and kvm-xfstests.  So for example, when we add
# support for support for Power architectures, the ARCH name that should
# be used is ppc64 or ppc64el.
#

function set_my_arch () {
    if test -n "${MY_ARCH:=}" ; then
        return
    fi
    local arch=$(uname -m)
    case $arch in
	aarch64)   MY_ARCH=arm64  ;;
	i386|i686) MY_ARCH=i386   ;;
	x86_64)    MY_ARCH=amd64  ;;
	*)         MY_ARCH=$arch  ;;
    esac
}

function set_default_arch ()
{
    if test -n "${ARCH:=}" ; then
	return
    fi
    if test -n "${DEFAULT_ARCH:=}" ; then
	ARCH="$DEFAULT_ARCH"
    else
	set_my_arch
	ARCH="$MY_ARCH"
    fi
}


# This function takes as input a user-supplied architecture (which
# generally should be a Debian port name, but users might use
# a $(uname -m) instead.
#
function set_canonicalized_arch () {
    case "$1" in
	arm64|aarch64)
	    ARCH="arm64"
	    GCE_ARCH="ARM64"
	    KERN_ARCH="arm64"
	    ;;
	i386)
	    ARCH="i386"
	    GCE_ARCH=""
	    KERN_ARCH="i386"
	    ;;
	x86-64|x86_64|X86_64|amd64)
	    ARCH="amd64"
	    GCE_ARCH="X86_64"
	    KERN_ARCH="x86_64"
	    ;;
	riscv64)
	    ARCH="riscv64"
	    GCE_ARCH=""
	    KERN_ARCH="riscv"
	    ;;
	*)
	    echo "Architecture $1 not supported"
	    exit 1
	    ;;
    esac
}

function set_cross_compile ()
{
    set_my_arch
    case "$ARCH" in
	arm64)
	    if test "$MY_ARCH" != arm64 ; then
		CROSS_COMPILE=aarch64-linux-gnu-
	    fi
	    ;;
    esac
}

function get_kernel_file_info () {
    local is_gs=
    local kernel="$1"
    KERNEL_ARCH=
    KERNEL_VERSION=

    case "$kernel" in
	gs://*)
	    is_gs=yes
	    ;;
    esac

    if test -n "$is_gs" ; then
	local f=$(mktemp --tmpdir gs_stat_XXXXXX)
	if ! run_gcloud_always storage objects describe --format=json "$kernel" > "$f" ; then
	    rm -f "$f"
	    exit 1
	fi
	{
	    IFS= read -r KERNEL_ARCH
	    IFS= read -r KERNEL_VERSION
	} < <(jq -r '
	    (.custom_fields // {}) as $cf |
	    ($cf.arch // ([ $cf | keys[] | select(startswith("arch=")) | ltrimstr("arch=") ][0]) // ""),
	    ($cf.ver  // ([ $cf | keys[] | select(startswith("ver="))  | ltrimstr("ver=")  ][0]) // "")
	' "$f")
	rm -f "$f"
    else
	if test ! -f "$kernel" ; then
	    echo "get-kernel-arch: file not found: $kernel" >&2
	    exit 1
	fi
	local info
	info=$(file -m "$DIR/util/kernel-magic" "$kernel")
	info="${info#"$kernel: "}"
	case "$info" in
	    "Linux kernel"*)
		KERNEL_ARCH=$(echo "$info" | tr A-Z a-z | awk '{print $3}')
		local resolved_kernel="$kernel"
		if command -v realpath > /dev/null 2>&1 ; then
		    resolved_kernel=$(realpath "$kernel" 2>/dev/null || echo "$kernel")
		elif command -v readlink > /dev/null 2>&1 ; then
		    resolved_kernel=$(readlink -f "$kernel" 2>/dev/null || echo "$kernel")
		fi
		local d
		d=$(dirname "$(dirname "$(dirname "$(dirname "$resolved_kernel")")")")
		if test -s "$d/.git_version" ; then
		    KERNEL_VERSION=$(head -n 1 "$d/.git_version")
		elif test -s "$d/include/config/kernel.release" ; then
		    KERNEL_VERSION=$(head -n 1 "$d/include/config/kernel.release")
		else
		    KERNEL_VERSION=$(printf '%s\n' "$info" | \
			sed -n 's/.*, version \([^, ]*\).*/\1/p')
		fi
		if test -f "$d/.config" ; then
		    if test "$KERNEL_ARCH" = "x86" ; then
			KERNEL_ARCH=$(head "$d/.config" | grep "^#.*Kernel Configuration" | \
				   awk '{print $2}' | sed -e 's;Linux/;;')
			if test "$KERNEL_ARCH" = "x86_64" ; then
			    KERNEL_ARCH=amd64
			fi
		    fi
		fi
		;;
	    "Debian binary package"*)
		if command -v dpkg > /dev/null 2>&1 ; then
		    KERNEL_ARCH=$(dpkg -I "$kernel" | grep "^ Architecture: " | \
			       awk '{print $2}')
		    KERNEL_VERSION=$(dpkg -I "$kernel" | grep "^ Version: " | \
			      awk '{print $2}')
		elif command -v ar > /dev/null 2>&1 ; then
		    local ctrl
		    ctrl=$(ar p "$kernel" control.tar.xz 2>/dev/null | tar -xJf - -O ./control 2>/dev/null || \
			   ar p "$kernel" control.tar.gz 2>/dev/null | tar -xzf - -O ./control 2>/dev/null || \
			   ar p "$kernel" control.tar.zst 2>/dev/null | tar --zstd -xf - -O ./control 2>/dev/null)
		    KERNEL_ARCH=$(printf '%s\n' "$ctrl" | awk '/^Architecture:/{print $2}')
		    KERNEL_VERSION=$(printf '%s\n' "$ctrl" | awk '/^Version:/{print $2}')
		fi
		;;
	    *)
		echo "get-kernel-arch $kernel is not a kernel" >&2
		echo "$info"
		exit 1
	esac
    fi
}
