# These must match gce-gcs-relay
PROTOCOL_VERSION = 1
RELAY_PREFIX = 'gcs-relay'

DEFAULT_TIMEOUT = 120.0
MAX_TIMEOUT = 3600.0

INSTANCE_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$')
PROJECT_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
BUCKET_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{1,221}$')

# Exit codes, as used by curl
E_UNSUPPORTED_PROTOCOL = 1
E_FAILED_INIT = 2
E_URL_MALFORMAT = 3
E_COULDNT_CONNECT = 7
E_HTTP_RETURNED_ERROR = 22
E_WRITE_ERROR = 23
E_READ_ERROR = 26
E_OPERATION_TIMEDOUT = 28
E_RECV_ERROR = 56

