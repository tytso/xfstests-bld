#
# Read the config files used for kvm-xfstests, gce-xfstests, etc.
#
# Shell scripts should use this file as follows:
#
# XFSTESTS_FLAVOR=kvm # (or gce, etc.)
# t=$(echo ${XFSTESTS_FLAVOR}_xfstests_dir | tr "[:lower:]" "[:upper:]")
# eval DIR="\$$t"
# if test -z "$DIR"
# then
#     DIR="$(dirname "$(readlink -f "$0")")"
# fi
# if test ! -f "$DIR/util/get-config"
# then
#     echo "$(basename "$0"): couldn't find $DIR/util/get-config"
#     exit 1
# fi
#
# . "$DIR/util/get-config"

# Source the default configs
. $DIR/config.common
. $DIR/config.${XFSTESTS_FLAVOR}

export KBUILD_DIR="$(dirname $DIR)/kernel-build"

# Source custom configs in ~/.config/ if present
[ -f "$HOME/.config/xfstests-common" ] && . "$HOME/.config/xfstests-common"

# If XFSTESTS_CONFIG is set, use that
# otherwise, look for config in default location ~/.config/
if [ -n "$XFSTESTS_CONFIG" -a -f "$XFSTESTS_CONFIG" ]; then
    . "$XFSTESTS_CONFIG"
else
    if [ -f "$HOME/.config/${XFSTESTS_FLAVOR}-xfstests" ]; then
	. "$HOME/.config/${XFSTESTS_FLAVOR}-xfstests"
    fi
    if [ -f "$HOME/.local/etc/${XFSTESTS_FLAVOR}-xfstests" ]; then
	. "$HOME/.local/etc/${XFSTESTS_FLAVOR}-xfstests"
    fi
fi

# For gce-xfstests, source the config for the active account if present
if test "$XFSTESTS_FLAVOR" = "gce" -a -z "$GCE_ACCOUNT" -a \
   -n "$(ls $DIR/config-* 2> /dev/null)"
then
   # We aren't just using GCE_ACCOUNT=$(...) to work around a performance
   # bug in gcloud.  This will hopefully be fixed soon.  :-)
   tmpfile=$(mktemp)
   gcloud config list --format='value(core.account)' core/account \
	2>/dev/null > "$tmpfile"
	GCE_ACCOUNT="$(cat $tmpfile)"
	rm "$tmpfile"
	unset tmpfile
fi
if test -n "$GCE_ACCOUNT" -a -f "$DIR/config-$GCE_ACCOUNT" ; then
    . "$DIR/config-$GCE_ACCOUNT"
fi

if test "$XFSTESTS_FLAVOR" = "gce" ; then
    function get_cache_dir() {
	for i in $HOME/.cache /tmp/$USER-cache ; do
	    GCE_CACHE_DIR=$i/gce-xfstests
	    mkdir -p $GCE_CACHE_DIR 2> /dev/null
	    if test -d $GCE_CACHE_DIR -a -w $GCE_CACHE_DIR ; then
		return
	    fi
	done
	GCE_CACHE_DIR=/tmp
    }

    function run_gcloud ()
    {
	if test -n "$GCE_ACCOUNT" ; then
	    $NO_ACTION gcloud --account "$GCE_ACCOUNT" --project "$GCE_PROJECT" "$@"
	else
	    $NO_ACTION gcloud --project "$GCE_PROJECT" "$@"
	fi
    }

    function run_gcloud_always ()
    {
	if test -n "$NO_ACTION" ; then
	    if test -n "$GCE_ACCOUNT" ; then
		echo gcloud --account "$GCE_ACCOUNT" --project "$GCE_PROJECT" \
		     "$@" > /dev/tty
	    else
		echo gcloud --project "$GCE_PROJECT" "$@" > /dev/tty
	    fi
	fi
	if test -n "$GCE_ACCOUNT" ; then
	    gcloud --account "$GCE_ACCOUNT" --project "$GCE_PROJECT" "$@"
	else
	    gcloud --project "$GCE_PROJECT" "$@"
	fi
    }

    function run_gcloud_prj ()
    {
	if test -n "$GCE_ACCOUNT" ; then
	    $NO_ACTION gcloud --account "$GCE_ACCOUNT" "$@"
	else
	    $NO_ACTION gcloud "$@"
	fi
    }

    function gcs_cp ()
    {
        run_gcloud storage cp "$@"
    }

    function gcs_cp_always ()
    {
        run_gcloud_always storage cp "$@"
    }

    function gcs_rm ()
    {
        run_gcloud storage rm "$@"
    }

    function gcs_ls ()
    {
        run_gcloud storage ls "$@"
    }

    function gcs_ls_always ()
    {
        run_gcloud_always storage ls "$@"
    }

    function gcs_cat ()
    {
        run_gcloud_always storage cat "$@"
    }

    function gcs_rsync ()
    {
        run_gcloud storage rsync --checksums-only "$@"
    }

    function gcs_exists ()
    {
        run_gcloud_always storage ls "$@" >& /dev/null
    }

    function gcs_list_direct_objects ()
    {
        local dir="${1%/}"
        gcs_ls_always "gs://$GS_BUCKET/$dir/" 2>/dev/null | grep -Ev '(/|^$)$'
    }

    function validate_gce_project ()
    {
        local proj="${1:-$GCE_PROJECT}"
        if [[ -z "$proj" || "$proj" == "." || "$proj" == ".." || \
              ! "$proj" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] ; then
            echo "Invalid or empty GCE_PROJECT: '$proj'" >&2
            return 1
        fi
        return 0
    }

    function extract_config_gce_project ()
    {
        sed -n -E \
            -e 's/^declare (--|-x|-xr|-rx) GCE_PROJECT="(.*)"$/\2/p' \
            -e 's/^GCE_PROJECT="(.*)"$/\1/p' \
            -e 's/^GCE_PROJECT=([^"].*)$/\1/p' \
            "$1" | tail -n 1
    }

    # Resolve where this project's gce_xfstests.config and TLS certificate
    # files live in $GS_BUCKET:
    #   - If the root gce_xfstests.config names $GCE_PROJECT (or has no
    #     GCE_PROJECT line), this project owns the legacy root slot:
    #     primary is gs://$GS_BUCKET, mirror is gs://$GS_BUCKET/project/$P.
    #   - If no root config exists, the slot is unclaimed; setup claims it.
    #   - If the root config names another project, or reading it failed for
    #     any other reason, primary is gs://$GS_BUCKET/project/$P and the
    #     root is never written.
    function resolve_gs_bucket_slot ()
    {
        if test "${GS_RESOLVED_FOR:-}" = "$GS_BUCKET:$GCE_PROJECT" -a \
                -n "${GS_SLOT_STATE:-}" -a -n "${GS_BUCKET_PREFIX:-}"
        then
            return 0
        fi

        local tmp_root tmp_err owner_proj mirror_prefix=""
        if validate_gce_project "$GCE_PROJECT" 2>/dev/null ; then
            mirror_prefix="gs://$GS_BUCKET/project/$GCE_PROJECT"
        fi
        tmp_root=$(mktemp "${TMPDIR:-/tmp}/gce_root_cfg.XXXXXX")
        tmp_err=$(mktemp "${TMPDIR:-/tmp}/gce_root_err.XXXXXX")

        if gcs_cat "gs://$GS_BUCKET/gce_xfstests.config" > "$tmp_root" 2> "$tmp_err"
        then
            owner_proj=$(extract_config_gce_project "$tmp_root")
            if test -z "$owner_proj" -o "$owner_proj" = "$GCE_PROJECT"
            then
                GS_SLOT_STATE="owner"
                GS_BUCKET_PREFIX="gs://$GS_BUCKET"
                GS_MIRROR_PREFIX="$mirror_prefix"
            else
                validate_gce_project "$GCE_PROJECT" || {
                    rm -f "$tmp_root" "$tmp_err"
                    exit 1
                }
                GS_SLOT_STATE="project"
                GS_BUCKET_PREFIX="gs://$GS_BUCKET/project/$GCE_PROJECT"
                GS_MIRROR_PREFIX=""
            fi
        elif grep -Eiq "matched no objects|notfound|404|no such object" "$tmp_err"
        then
            GS_SLOT_STATE="unclaimed"
            GS_BUCKET_PREFIX="gs://$GS_BUCKET"
            GS_MIRROR_PREFIX="$mirror_prefix"
        else
            validate_gce_project "$GCE_PROJECT" || {
                rm -f "$tmp_root" "$tmp_err"
                exit 1
            }
            GS_SLOT_STATE="error"
            GS_BUCKET_PREFIX="gs://$GS_BUCKET/project/$GCE_PROJECT"
            GS_MIRROR_PREFIX=""
        fi

        rm -f "$tmp_root" "$tmp_err"
        GS_RESOLVED_FOR="$GS_BUCKET:$GCE_PROJECT"
        export GS_RESOLVED_FOR GS_SLOT_STATE GS_BUCKET_PREFIX GS_MIRROR_PREFIX
    }

    function gs_config_exists ()
    {
        resolve_gs_bucket_slot
        if test "$GS_SLOT_STATE" = "owner" ; then
            return 0
        fi
        if test "$GS_SLOT_STATE" = "unclaimed" ; then
            return 1
        fi
        gcs_exists "$GS_BUCKET_PREFIX/gce_xfstests.config"
    }

    function sync_gs_config ()
    {
        if test -n "$SKIP_GS_CONFIG_UPDATE" ; then
            return 0
        fi
        resolve_gs_bucket_slot

        local gs_config="$GS_BUCKET_PREFIX/gce_xfstests.config"
        local local_config="${TMPDIR:-/tmp}/.gce_xfstests.config.${USER:-root}-$GCE_PROJECT"
        local tmp_config tmp_remote
        tmp_config=$(mktemp "${TMPDIR:-/tmp}/gce_xfstests.config.XXXXXXXX")

        (
            : "${GCE_IMAGE_PROJECT=}"
            SENDGRID_API_KEY="$GCE_SG_API"
            SMTP_SERVER="$GCE_SMTP_SERVER"
            SMTP_PORT="$GCE_SMTP_PORT"
            SMTP_USER="$GCE_SMTP_USER"
            SMTP_PASSWORD="$GCE_SMTP_PASSWORD"
            SMTP_CAFILE="$GCE_SMTP_CAFILE"
            TLS_MODE="$GCE_TLS_MODE"
            declare -p GCE_REPORT_SENDER
            declare -p GCE_REPORT_EMAIL
            declare -p GCE_REPORT_FAIL_EMAIL
            declare -p GCE_JUNIT_EMAIL
            declare -p SENDGRID_API_KEY
            declare -p SMTP_SERVER
            declare -p SMTP_PORT
            declare -p SMTP_USER
            declare -p SMTP_PASSWORD
            declare -p SMTP_CAFILE
            declare -p TLS_MODE
            declare -p GCE_UPLOAD_SUMMARY
            declare -p PRIMARY_FSTYPE
            declare -p GCE_PROJECT
            declare -p GCE_IMAGE_PROJECT
            declare -p ARCH
            declare -p GCE_ZONE
            declare -p GCE_ZONE2
            declare -p NR_CPU
            declare -p MEM
            declare -p GS_BUCKET
            declare -p BUCKET_SUBDIR
            declare -p GCE_MIN_SCR_SIZE
            declare -p GCE_LTM_KEEP_DEAD_VM
            declare -p GCE_NETWORK
            declare -p GCE_SERIAL_PORT_ACCESS
            declare -p TZ
            declare -p GCE_LTM_MACHTYPE
            declare -p GCE_KCS_MACHTYPE
            declare -p GIT_REPOS
        ) 2>/dev/null > "$tmp_config"

        if ! cmp -s "$tmp_config" "$local_config"
        then
            tmp_remote=$(mktemp /tmp/gce_remote_cfg.XXXXXXXX)
            if ! gcs_cat "$gs_config" > "$tmp_remote" 2>/dev/null || \
               ! cmp -s "$tmp_config" "$tmp_remote"
            then
                echo "Updating config file at $gs_config"
                gcs_cp_always "$tmp_config" "$gs_config"
                if test "$GS_SLOT_STATE" = "unclaimed" ; then
                    GS_SLOT_STATE="owner"
                    export GS_SLOT_STATE
                fi
                if test -n "$GS_MIRROR_PREFIX" ; then
                    gcs_cp_always "$tmp_config" "$GS_MIRROR_PREFIX/gce_xfstests.config" 2>/dev/null
                fi
            elif test -n "$GS_MIRROR_PREFIX"
            then
                if ! gcs_cat "$GS_MIRROR_PREFIX/gce_xfstests.config" > "$tmp_remote" 2>/dev/null || \
                   ! cmp -s "$tmp_config" "$tmp_remote"
                then
                    gcs_cp_always "$tmp_config" "$GS_MIRROR_PREFIX/gce_xfstests.config" 2>/dev/null
                fi
            fi
            rm -f "$tmp_remote"

            mv -f "$tmp_config" "$local_config"
        else
            rm -f "$tmp_config"
        fi
    }

    # Run the curl-compatible program which is used to send requests
    # to the LTM and KCS servers.  The first argument is the name of
    # the instance where the server is running; the rest of the
    # arguments are passed to the program.
    #
    # By default the program is curl, but GCE_CURL can be set to the
    # pathname of a program which accepts curl's command-line options
    # but which uses some other way of reaching the server.  If
    # GCE_CURL does not contain a slash and names an executable in
    # the util directory (for example, gce-gcs-curl), that program
    # will be used.  So that the program can find the server, the
    # instance name is passed in the GCE_INSTANCE environment
    # variable, along with GCE_PROJECT, GCE_ZONE, GS_BUCKET, and
    # GCE_ACCOUNT.
    function run_gce_curl ()
    {
	local instance="$1"
	local curl="${GCE_CURL:-curl}"
	shift

	case "$curl" in
	    */*) ;;
	    *)
		if test -x "$DIR/util/$curl" ; then
		    curl="$DIR/util/$curl"
		fi
		;;
	esac
	GCE_INSTANCE="$instance" GCE_PROJECT="$GCE_PROJECT" \
	    GCE_ZONE="$GCE_ZONE" GS_BUCKET="$GS_BUCKET" \
	    GCE_ACCOUNT="$GCE_ACCOUNT" "$curl" "$@"
    }

    GCE_DASHBOARD_SERVICE_IAM=dashboard
    SERVICE_ACCOUNT_VM="test-vm@$GCE_PROJECT.iam.gserviceaccount.com"
    SERVICE_ACCOUNT_LTM="ltm-kcs@$GCE_PROJECT.iam.gserviceaccount.com"
    SERVICE_ACCOUNT_IMG="img-create@$GCE_PROJECT.iam.gserviceaccount.com"
    SERVICE_ACCOUNT_DASH="dashboard@$GCE_PROJECT.iam.gserviceaccount.com"

    # setup a cached set of service account options
    get_cache_dir
    GCE_MACHTYPE_FILE=$GCE_CACHE_DIR/machtype_file
    SA="$GCE_CACHE_DIR/service-accounts-opts.$GCE_PROJECT"
    if test -r "$SA" ; then
	. "$SA"
    else
	if run_gcloud_always iam service-accounts describe \
			     "$SERVICE_ACCOUNT_VM" >& /dev/null ; then
	    SERVICE_ACCOUNT_OPT_VM="--service-account $SERVICE_ACCOUNT_VM"
	    SERVICE_ACCOUNT_OPT_LTM="--service-account $SERVICE_ACCOUNT_LTM"
	    SERVICE_ACCOUNT_OPT_IMG="--service-account $SERVICE_ACCOUNT_IMG"
	else
	    SERVICE_ACCOUNT_OPT_VM=
	    SERVICE_ACCOUNT_OPT_LTM=
	    SERVICE_ACCOUNT_OPT_IMG=
	fi
	declare -p SERVICE_ACCOUNT_OPT_VM > "$SA.$$"
	declare -p SERVICE_ACCOUNT_OPT_LTM >> "$SA.$$"
	declare -p SERVICE_ACCOUNT_OPT_IMG >> "$SA.$$"
	if test -r "$SA" ; then
	    rm -f "$SA.$$"
	else
	    mv "$SA.$$" "$SA"
	fi
    fi
    unset SA

    # check whether this machine runs in the same GCE project
    if ping -c 1 -q metadata.google.internal >& /dev/null ; then
        # We must be running on an GCE VM since a DNS resolution of
        # metadata.google.internal succeeded.
	my_project=
	if test -x /bin/facter ; then
	   my_project="$(/bin/facter gce.project.projectId)"
	elif test -f /usr/local/lib/gce-funcs ; then
	    . /usr/local/lib/gce-funcs
	    my_project="$(get_metadata_value project-id)"
	fi
	if test -n "$my_project" ; then
	    if test "$my_project" = "$GCE_PROJECT" ; then
		RUN_INTERNAL="--internal-ip"
            fi
	else
            # fall back to check with internal ip
            INT_IP=$(hostname -I)
	    INT_LIST=$(gcloud compute instances list \
		      --project "$GCE_PROJECT" \
		      --filter="networkInterfaces[0].networkIP:$INT_IP")
	    if test -n "$INT_LIST" ; then
		RUN_INTERNAL="--internal-ip"
            fi
	fi
    fi

    if test -z "$GCE_SERIAL_PORT_ACCESS" ; then
	GCE_SERIAL_PORT_ACCESS=TRUE
    fi
fi
