. "$DIR/.ltm_instance_$GCE_PROJECT"

# The hostname has to match the certificate SAN/CN generated in
# util/gce-setup-cert for the project's self-signed certificate.
LTM_HOSTNAME="a.${GCE_PROJECT//:/-}.gce-xfstests"
function ltm_post_json() {
    local target_ip="${GCE_LTM_EXT_IP:-}"
    local resp rc

    if test -n "${GCE_LTM_INT_IP:-}"; then
	target_ip="$GCE_LTM_INT_IP"
    fi
    resp=$(run_gce_curl "${GCE_LTM_NAME:-xfstests-ltm}" -s -S \
	--cacert "$GCE_LTM_SERVER_CERT" -H "Content-Type: application/json" \
	--resolve "$LTM_HOSTNAME:443:$target_ip" -X POST "$@")
    rc=$?
    if test "$rc" -ne 0 -o -z "$resp"; then
	if test -n "$resp"; then
	    printf '%s\n' "$resp" >&2
	fi
	return 1
    fi
    if ! printf '%s\n' "$resp" | jq '.' ; then
	printf '%s\n' "$resp" >&2
	return 1
    fi
    if printf '%s\n' "$resp" | jq -e 'type == "object" and has("status") and (.status == false)' >/dev/null 2>&1 ; then
	if printf '%s\n' "$resp" | jq -e '.msg == "Login failed" or .msg == "Failed to retrieve user session"' >/dev/null 2>&1 ; then
	    rm -f "$DIR/.ltm_cookie_$GCE_PROJECT"
	fi
	return 2
    fi
    return 0
}

function ltm_post_failed() {
    if run_gcloud compute instances describe "xfstests-ltm" &> /dev/null; then
	echo "The ltm instance seems to be running. Try deleting the"
	echo "$DIR/.ltm_instance_$GCE_PROJECT file and re-running launch-ltm to recreate"
	echo "the file. If the issue persists, try relaunching the LTM"
	echo "If configuration changes have been made, it may be necessary"
	echo "to delete and re-launch the LTM."
    else
	echo "The ltm doesn't seem to be running. Try launching the ltm"
	echo "instance with launch-ltm. This will recreate the"
	echo ".ltm_instance_$GCE_PROJECT file."
    fi
}

function send_to_ltm() {
    local cmd_to_send="$1"
    local cookie_file="$DIR/.ltm_cookie_$GCE_PROJECT"
    local login_payload payload rc
    shift

    if test ! -f "$cookie_file" || ! grep -Fq "$LTM_HOSTNAME" "$cookie_file" 2>/dev/null
    then
	login_payload=$(jq -cn --arg password "${GCE_LTM_PWD:-}" '{password: $password}')
	ltm_post_json -c "$cookie_file" -d "$login_payload" \
	    "https://$LTM_HOSTNAME/login"
	rc=$?
	if test "$rc" -ne 0; then
	    rm -f "$cookie_file"
	    echo "Login failed."
	    if test "$rc" -eq 1; then
		ltm_post_failed
	    fi
	    return 1
	fi
	echo
    fi

    if test -n "${LTM_INFO:-}"; then
	ltm_post_json -b "$cookie_file" "https://$LTM_HOSTNAME/status"
	rc=$?
	if test "$rc" -ne 0; then
	    echo "Request failed."
	    if test "$rc" -eq 1; then
		ltm_post_failed
	    fi
	    return 1
	fi
	echo
    else
	payload=$(jq -cn \
	    --arg orig_cmdline "$cmd_to_send" \
	    --arg no_region_shard "${NO_REGION_SHARD:-}" \
	    --arg bucket_subdir "${BUCKET_SUBDIR:-}" \
	    --arg gs_kernel "${GS_KERNEL:-}" \
	    --arg has_report_email "${GCE_REPORT_EMAIL+x}" \
	    --arg report_email "${GCE_REPORT_EMAIL:-}" \
	    --arg has_report_fail_email "${GCE_REPORT_FAIL_EMAIL+x}" \
	    --arg report_fail_email "${GCE_REPORT_FAIL_EMAIL:-}" \
	    --arg has_junit_email "${GCE_JUNIT_EMAIL+x}" \
	    --arg junit_email "${GCE_JUNIT_EMAIL:-}" \
	    --arg commit_id "${COMMIT:-}" \
	    --arg git_repo "${GIT_REPO:-}" \
	    --arg branch_name "${BRANCH:-}" \
	    --arg watch_skip_initial "${WATCH_SKIP_INITIAL:-}" \
	    --arg unwatch "${WATCHER_ID:-}" \
	    --arg bad_commit "${BISECT_BAD:-}" \
	    --arg good_commit "${BISECT_GOOD:-}" \
	    --arg kconfig "${KCONFIG:-}" \
	    --arg kconfig_opts "${KCONFIG_OPTS:-}" \
	    --arg kbuild_opts "${KBUILD_OPTS:-}" \
	    --arg arch "${ARCH:-}" \
	    --arg monitor_timeout "${MONITOR_TIMEOUT:-}" \
	    --arg test_run_id "${TESTRUNID:-}" \
	    '({}
	      + (if $no_region_shard != "" then {no_region_shard: true} else {} end)
	      + (if $bucket_subdir != "" then {bucket_subdir: $bucket_subdir} else {} end)
	      + (if $gs_kernel != "" then {gs_kernel: $gs_kernel} else {} end)
	      + (if $has_report_email != "" then {report_email: $report_email} else {} end)
	      + (if $has_report_fail_email != "" then {report_fail_email: $report_fail_email} else {} end)
	      + (if $has_junit_email != "" then {junit_email: $junit_email} else {} end)
	      + (if $commit_id != "" then {commit_id: $commit_id} else {} end)
	      + (if $git_repo != "" then {git_repo: $git_repo} else {} end)
	      + (if $branch_name != "" then {branch_name: $branch_name} else {} end)
	      + (if $watch_skip_initial != "" then {watch_skip_initial: true} else {} end)
	      + (if $unwatch != "" then {unwatch: $unwatch} else {} end)
	      + (if $bad_commit != "" then {bad_commit: $bad_commit} else {} end)
	      + (if $good_commit != "" then {good_commit: $good_commit} else {} end)
	      + (if $kconfig != "" then {kconfig: $kconfig} else {} end)
	      + (if $kconfig_opts != "" then {kconfig_opts: $kconfig_opts} else {} end)
	      + (if $kbuild_opts != "" then {kbuild_opts: $kbuild_opts} else {} end)
	      + (if $arch != "" then {arch: $arch} else {} end)
	      + (if $monitor_timeout != "" then {monitor_timeout: $monitor_timeout} else {} end)
	      + (if $test_run_id != "" then {test_run_id: $test_run_id} else {} end)
	     ) as $opts
	     | if ($opts | length) > 0 then
		 {orig_cmdline: $orig_cmdline, options: $opts}
	       else
		 {orig_cmdline: $orig_cmdline}
	       end')

	ltm_post_json -b "$cookie_file" -d "$payload" \
	    "https://$LTM_HOSTNAME/gce-xfstests"
	rc=$?
	if test "$rc" -ne 0; then
	    echo "Request failed."
	    if test "$rc" -eq 1; then
		ltm_post_failed
	    fi
	    return 1
	fi
	echo
    fi
}
